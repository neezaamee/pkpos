# ==============================================================================
# PK POS Root Git Ignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
vendor/
**/vendor/

# Rust / Tauri Build Artifacts
**/src-tauri/target/
**/target/

# Frontend & Vite Distribution Builds
dist/
**/dist/
public/build/
**/public/build/
public/hot
**/public/hot
public/storage
**/public/storage

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.key
auth.json

# Cache & Testing
.phpunit.cache
.phpunit.result.cache
**/.phpunit.cache
**/.phpunit.result.cache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
storage/logs/*
**/storage/logs/*
!storage/logs/.gitignore
!**/storage/logs/.gitignore

# Laravel Framework Dynamic Storage Cache
storage/framework/cache/data/*
**/storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
!**/storage/framework/cache/data/.gitignore
storage/framework/sessions/*
**/storage/framework/sessions/*
!storage/framework/sessions/.gitignore
!**/storage/framework/sessions/.gitignore
storage/framework/testing/*
**/storage/framework/testing/*
!storage/framework/testing/.gitignore
!**/storage/framework/testing/.gitignore
storage/framework/views/*
**/storage/framework/views/*
!storage/framework/views/.gitignore
!**/storage/framework/views/.gitignore

# IDEs & System Metadata
.idea/
.vscode/
.fleet/
.DS_Store
Thumbs.db

# Empty placeholder directories
pk-pos-d/
pk-pos-f/admin/

